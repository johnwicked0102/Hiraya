# ---------------------------------------------------------------------------
# Hiraya configuration. Copy to .env.local for development; set the same keys
# in Vercel → Project → Settings → Environment Variables for production.
# ---------------------------------------------------------------------------

# Public URL of the app (no trailing slash). Used for OAuth redirects and origin checks.
APP_URL=http://localhost:3000

# Postgres connection string. On Supabase use the "Transaction pooler" URI (port 6543).
DATABASE_URL=postgres://postgres:password@localhost:5432/hiraya
# Set to "disable" only for a local Postgres without TLS.
DATABASE_SSL=require

# Long random secrets — generate each with:  openssl rand -base64 48
AUTH_SECRET=change-me-to-a-long-random-string-of-at-least-32-chars
ENCRYPTION_KEY=change-me-to-a-different-long-random-string-32-chars
# One-time token that unlocks /setup to create the first administrator.
SETUP_TOKEN=change-me-setup-token

# Google Drive (Google Cloud Console → APIs & Services → Credentials → OAuth client, type "Web application").
# Authorized redirect URI:  {APP_URL}/api/drive/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Optional: name of the archive folder created in the administrator's Drive.
DRIVE_ROOT_FOLDER_NAME=Hiraya Family Archive

# Optional: time zone for greetings and "today" on the calendar.
FAMILY_TIMEZONE=Asia/Manila
